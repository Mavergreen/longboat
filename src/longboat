#!/bin/sh
# platform: host-agnostic
#   usage: longboat list | fetch <version> --into DIR | install <version> [--pkg-only DIR] | --help
#          longboat fetch installer <release> --into DIR [source flags]   exec libexec/longboat/installmedia
#          longboat verify installer <release> <image>                    exec libexec/longboat/installmedia
set -eu
SELF_PATH="$0"
while [ -L "$SELF_PATH" ]; do
  _l="$(readlink "$SELF_PATH")"
  case "$_l" in
    /*) SELF_PATH="$_l" ;;
    *) SELF_PATH="$(dirname "$SELF_PATH")/$_l" ;;
  esac
done
SELF="$(cd "$(dirname "$SELF_PATH")" && pwd)"
if [ -d "$SELF/../libexec/longboat" ]; then
  LIBEXEC="$(cd "$SELF/../libexec/longboat" && pwd)"
else
  LIBEXEC="$SELF"
fi
LONGBOAT_SHIPYARD_DIR="${LONGBOAT_SHIPYARD_DIR:-$LIBEXEC/shipyard}"
export LONGBOAT_SHIPYARD_DIR
MAVERGREEN_PROGRESS=1
export MAVERGREEN_PROGRESS
. "$LIBEXEC/sdks.sh"
. "$LIBEXEC/progress.sh"
. "$LIBEXEC/fetch.sh"
LB_INSTALL_SH="$LIBEXEC/install.sh"
. "$LIBEXEC/install.sh"

usage() {
  echo "usage: longboat list | fetch <version> --into DIR | install <version> [--pkg-only DIR] | --help"
  echo "       longboat fetch installer <release> --into DIR [--source-recipe] [--source-file PATH]"
  echo "                [--source-url URL [--auth-header-env NAME]] [--source-command PATH]"
  echo "       longboat verify installer <release> <image>"
}

lb_installmedia() {
  [ -x "$LIBEXEC/installmedia" ] || {
    echo "longboat: no $LIBEXEC/installmedia; build/build-installmedia.sh builds it" >&2
    exit 1
  }
  exec "$LIBEXEC/installmedia" "$@"
}

case "${1:-}" in
  list)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    offered="$(lb_offered)" || exit 1
    [ -n "$offered" ] || exit 0
    printf '%s\n' "$offered" | while read -r ver short arch dir; do
      if [ -f "${LONGBOAT_ROOT:-}/usr/local/mavergreen/$short/mavergreen.plist" ]; then
        echo "$ver $short installed"
      else
        echo "$ver $short available"
      fi
    done ;;
  fetch)
    [ "${2:-}" != installer ] || lb_installmedia "$@"
    shift
    lb_progress_init 1
    lb_fetch_step 1 "$@" ;;
  verify)
    [ "${2:-}" = installer ] || { usage >&2; exit 2; }
    lb_installmedia "$@" ;;
  install)
    shift
    lb_install "$@" ;;
  --help|-h)
    usage ;;
  *)
    usage >&2
    exit 2 ;;
esac
